#include<bits/stdc++.h>
using namespace std;
class node
{
    public:
    int val;
    node* next;
    node(int x)
    {
        val=x;
        next=nullptr;
    }
};
//insert at the end
void inserte(node* &head,int x)
{
    node* temp=new node(x);
    if(head==nullptr)
    {
        head=temp;
        return;
    }
    node* cur=head;
    while(cur->next!=nullptr)
    {
        cur=cur->next;
    }
    cur->next=temp;
}
//display the elements
void dispaly(node* head)
{
    node* temp=head;
    while(temp!=nullptr)
    {
        cout<<temp->val;
        if(temp->next!=NULL)
        {
            cout<<"->";
        }
        temp=temp->next;
    }
}
//deltete at the position
void deletep(node* &head,int pos)
{
    if(pos==0)
    {
        node* temp=head;
        head=head->next;
        free(temp);
    }
    node* temp=head;
    int cur=0;
    while((cur!=pos-2)&&(temp!=NULL))
    {
        temp=temp->next;
        cur++;
    }
    node* mad=temp->next;
    temp->next=temp->next->next;
    free(mad);
}
//insert at the head
void inserth(node* &head,int x)
{
    node* temp=new node(x);
    temp->next=head;
    head=temp;
}
//insert at the position
void insertp(node* &head,int pos,int x)
{
    if(pos==0)
    {
        inserth(head,x);
    }
    int currpos=0;
    node* cur=head;
    node* temp=new node(x);
    while((currpos!=pos-1)&& (cur!=NULL))
    {
        cur=cur->next;
        currpos++;
    }
    if(cur==NULL)
    {
        return;
    }
    temp->next=cur->next;
    cur->next=temp;
}
//delete at the begining
void deleteb(node* &head)
{
    node* temp=head;
    head=head->next;
    free(temp);
}
//delete at the end
void deletee(node* &head)
{
    node* temp=head;
    while(temp->next->next!=NULL)
    {
        temp=temp->next;
    }
    node* dummy=temp->next;
    temp->next=NULL;
    free(dummy);
}
//delete alternate nodes of the linkedlist
void deleteal(node* &head)
{
    node* temp=head;
    while((temp!=NULL)&&(temp->next!=NULL))
    {
        node* temp1=temp->next;
        temp->next=temp->next->next;
        free(temp1);
        temp=temp->next;
    }
}
//delete duplicate elements
void deleteduplicate(node* &head)
{
    node* temp=head;
    while(temp!=NULL)
    {
        while((temp->next!=NULL)&&(temp->val==temp->next->val))
        {
            node* dummy=temp->next;
            temp->next=temp->next->next;
            free(dummy);
        }
        temp=temp->next;
    }
}
//reversing the linked list
node* reverse(node* head)
{
    node* prev=NULL;
    node* curr=head;
    while(curr!=NULL)
    {
        node* nextptr=curr->next;
        curr->next=prev;
        prev=curr;
        curr=nextptr;
    }
    node* new_node=prev;
    return prev;
}
//reverse the array in groups
node* reverseg(node* head,int a)
{
    node* prev=NULL;
    node* temp=head;
    int count=0;
    while((temp!=NULL)&&(count<a))
    {
        node* nexte=temp->next;
        temp->next=prev;
        prev=temp;
        temp=nexte;
        count++;
    }
    if(temp!=NULL)
    {
        node* newhead=reverseg(temp,a);
        head->next=newhead;
    }
    return prev;
}
//find the length of the linked list
int length(node* &head)
{
    int count=0;
    node* temp=head;
    while(temp!=NULL)
    {
        count++;
        temp=temp->next;
    }
    return count;
}
//delete the element at the end
void deletefromend(node* &head,int k)
{
    int l=length(head);
    if(l<k)
    {
        return;
    }
    node* ptr1=head;
    node* ptr2=head;
    while(k--)
    {
        ptr2=ptr2->next;
    }
    if(ptr2==NULL)
    {
        node* mad=ptr1;
        ptr1->next=ptr1->next->next;
        free(mad);
    }
    while(ptr2->next!=NULL)
    {
        ptr1=ptr1->next;
        ptr2=ptr2->next;
    }
    node* temp=ptr1;
    ptr1->next=ptr1->next->next;
    free(temp);
}
//merge the two linked lists
node* merge(node* head1,node* head2)
{
    node* dummy=new node(-1);
    node* ptr1=head1;
    node* ptr2=head2;
    node* ptr3=dummy;
    while(ptr1 && ptr2)
    {
        if(ptr1->val < ptr2->val)
        {
            ptr3->next=ptr1;
            ptr1=ptr1->next;
        }
        else{
            ptr3->next=ptr2;
            ptr2=ptr2->next;
        }
        ptr3=ptr3->next;
    }
    while(ptr1)
    {
        ptr3->next=ptr1;
        ptr1=ptr1->next;
    }
    while(ptr2)
    {
        ptr3->next=ptr2;
        ptr2=ptr2->next;
    }
    return ptr3->next;
}
//check weather the given linked list is palindrome or not
bool ispalindrom(node* head)
{
    node* slow=head;
    node* fast=head;
    while(fast!=NULL && fast->next !=NULL)
    {
        slow=slow->next;
        fast=fast->next->next;
    }
    node* temp=slow->next;
    node* prev=slow;
    slow->next=NULL;
    while(temp!=NULL)
    {
        node* next=temp->next;
        temp->next=prev;
        prev=temp;
        temp=next;
    }
    node* head1=head;
    node* head2=prev;
    while(head2)
    {
        if(head1->val!=head2->val)
        {
            return false;
        }
        head1=head1->next;
        head2=head2->next;
    }
    return true;
}
//rotate the linked list by k node
node* rotate(node* &head, int k)
{
    node* tail=head;
    int n=0;
    while(tail->next!=NULL)
    {
        tail=tail->next;
        n++;
    }
    n++;
    k=k%n;
    if(k==0)
    {
        return head;
    }
    tail->next=head;
    node* tailnode=head;
    for(int i=0;i<n-k;i++)
    {
        tailnode=tailnode->next;
    }
    node* newnode=tailnode->next;
    tailnode->next=NULL;
    return newnode;
}
//print even indices at first and odd indices at last
node* evenodd(node* &head)
{
   node* evenhead=head->next;
   node* oddptr=head;
